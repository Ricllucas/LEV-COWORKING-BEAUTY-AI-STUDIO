# ===================================
# FRONTEND VARIABLES (VITE_* prefix)
# ===================================
# These variables are exposed to the browser
# Only include non-sensitive, public keys here

# Supabase Configuration (Public Key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGc...

# ===================================
# BACKEND VARIABLES (Server-side only)
# ===================================
# These variables run only on Vercel serverless functions
# NEVER use the VITE_ prefix for sensitive credentials!

# Supabase Service Role (Full Admin Access - SENSITIVE!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Google Gemini API (AI Features)
GEMINI_API_KEY=AIzaSyD...

# ===================================
# GOOGLE CALENDAR INTEGRATION
# ===================================
# Integração automática de agendamentos com Google Agenda compartilhada
# Permite que Elisangela, Talitha e Nayara vejam todos os agendamentos

# Shared Calendar ID (Find in Google Calendar Settings)
GOOGLE_CALENDAR_ID=abc123def456@group.calendar.google.com

# Service Account Email (from Google Cloud Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=lev-coworking-beauty@project-123456.iam.gserviceaccount.com

# Service Account Private Key (from JSON key file - KEEP SECURE!)
# Format: "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADA...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===================================
# WHATSAPP BUSINESS API INTEGRATION
# ===================================
# Notificações automáticas para as profissionais quando novo agendamento é feito

# WhatsApp Access Token (from Meta Business Platform)
WHATSAPP_ACCESS_TOKEN=EAAG...

# WhatsApp Business Phone Number ID (from WhatsApp Business Settings)
WHATSAPP_PHONE_NUMBER_ID=1234567890

# WhatsApp App Secret (from Meta App Settings)
WHATSAPP_APP_SECRET=abc123def456xyz789

# WhatsApp Webhook Verification Token (choose any random string for security)
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_123

# WhatsApp Automation Secret (for automation flows)
WHATSAPP_AUTOMATION_SECRET=your_automation_secret_abc123

# WhatsApp Message Template Name (for appointment confirmations)
WHATSAPP_CONFIRMATION_TEMPLATE=confirmacao_agendamento_lev

# WhatsApp Graph API Version
WHATSAPP_GRAPH_VERSION=v23.0

# ===================================
# SETUP INSTRUCTIONS
# ===================================

# SUPABASE:
# 1. Go to https://supabase.com
# 2. Create a new project
# 3. Copy credentials from Project Settings > API

# GOOGLE CALENDAR:
# 1. Create Google Cloud Project: https://console.cloud.google.com
# 2. Enable Google Calendar API
# 3. Create Service Account (Credentials > Service Account)
# 4. Generate private key (JSON format)
# 5. Create shared calendar and share with service account email
# 6. Extract values and paste here

# WHATSAPP:
# 1. Create WhatsApp Business Account: https://business.facebook.com
# 2. Create App and configure WhatsApp integration
# 3. Set webhook URL: https://your-app.vercel.app/api/whatsapp/webhook
# 4. Copy tokens from WhatsApp Settings
# 5. Create message templates for confirmations

# ===================================
# SECURITY NOTES
# ===================================

# 1. NEVER commit this file with real values!
#    Git should ignore .env files (check .gitignore)
#
# 2. Only use environment secrets in:
#    - Vercel: Project Settings > Environment Variables
#    - Local development: Create .env (copy from .env.example)
#
# 3. Rotate credentials regularly
#    - WhatsApp tokens: Check Meta Business Suite
#    - Service accounts: Google Cloud Console
#    - Supabase keys: Regenerate in Project Settings
#
# 4. Keep private keys safe!
#    - GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY contains sensitive data
#    - SUPABASE_SERVICE_ROLE_KEY has full database access
#    - WHATSAPP_ACCESS_TOKEN controls messaging
